<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.court-auction.notices</string>
  <!-- 문서 폴더는 TCC 보호 대상이라 launchd가 직접 chdir·로그 열기를 못 한다.
       전체 디스크 접근이 부여된 zsh 안에서 cd와 리다이렉션을 수행한다. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "/Users/bymsub/Documents/경매물건 크롤링" &amp;&amp; exec /bin/zsh scripts/run_notices.sh</string>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/bymsub/Library/Logs/court-auction/notices.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bymsub/Library/Logs/court-auction/notices.launchd.err.log</string>
  <!-- 2026-10-04 사용자 결정: 매일 → 주 2회(월·목). 공고는 한 번 올라오면 안 바뀌고 목록에 중앙 75일 남는다.
       새 공고는 평일에 올라오고 월요일 회차에 가장 많이 잡혔다(296~504건). Weekday 1=월 4=목. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>5</integer>
      <key>Minute</key><integer>40</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>5</integer>
      <key>Minute</key><integer>40</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
